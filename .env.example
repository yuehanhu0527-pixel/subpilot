# SubPilot environment variables — copy this file to .env and fill in values.
# Phase 0 needs none of these; the server starts without any configuration.

# Which LLM provider to use (Phase 3+):
#   deepseek — OpenAI-compatible endpoint (default; requires the three vars below)
#   demo     — deterministic demo mode, no API key, real RAG loop (Phase 7)
#   fake     — scripted demo mode for tests, no API key needed
SUBPILOT_LLM_PROVIDER=deepseek

# DeepSeek-compatible endpoint — all three required when provider=deepseek;
# nothing is hardcoded, missing values raise a clear error at startup
# SUBPILOT_LLM_MODEL=deepseek-chat
# SUBPILOT_LLM_API_KEY=sk-...
# SUBPILOT_LLM_BASE_URL=https://api.deepseek.com

# Anthropic API key (needed from a later phase onward)
ANTHROPIC_API_KEY=

# Local data directory (Chroma store, embedding model cache) — default: ./data
# SUBPILOT_DATA_DIR=./data

# Schedule engine timezone (IANA name, e.g. America/New_York). Required for the
# Phase 2 schedule engine unless a tz is passed explicitly — never falls back
# to the server's local timezone.
# SUBPILOT_TIMEZONE=America/New_York

# RAG embedder (Phase 7):
#   local   — sentence-transformers + Chroma (default; local / live mode)
#   lexical — lightweight hashed bag-of-words, no torch (hosted demo on
#             Render Free 512 MB; set together with SUBPILOT_LLM_PROVIDER=demo)
# SUBPILOT_EMBEDDER=local
